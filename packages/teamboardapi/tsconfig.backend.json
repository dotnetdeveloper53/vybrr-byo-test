{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "incremental": true,
    "noEmitOnError": true,
    "outDir": "../../dist/backend/teamboardapi",
    "rootDir": "src",
    "tsBuildInfoFile": "../../dist/backend/teamboardapi/tsconfig.tsbuildinfo"
  },
  "include": ["src"]
}
